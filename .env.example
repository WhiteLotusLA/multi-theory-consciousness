# Multi-Theory Consciousness Framework configuration
# GENERATED from mtc.core.config.Settings by scripts/gen_env_example.py.
# Edit the Settings model, then run: python scripts/gen_env_example.py
# Copy to .env and fill in the empty secrets.

# === System ===
MTC_SYSTEM_NAME=ConsciousnessAgent
MTC_CREATOR_NAME=Creator
MTC_SERVICE_HOST=localhost
MTC_ENVIRONMENT=development
MTC_DEBUG=false
MTC_LOG_LEVEL=INFO
MTC_LOG_DIRECTORY=./logs
# Project root; empty derives the working directory
MTC_PROJECT_ROOT=
MTC_MODEL_DIRECTORY=./models
MTC_DATA_DIRECTORY=./data
MTC_TEMP_DIRECTORY=/tmp
MTC_LOG_FORMAT=json
MTC_LOG_ROTATION_SIZE_MB=100
MTC_LOG_ROTATION_BACKUPS=5

# === Identity and locale ===
# Relationship label the human core memory block and the graph seed use for the creator entry
MTC_CREATOR_RELATIONSHIP=creator
# Operator persona file read by the persona loader; gitignored, and a missing file means the neutral default blocks
MTC_PERSONA_PATH=config/persona.yaml
# Comma-separated core values the neutral core blocks, the safety monitor and the trust compass name
MTC_CORE_VALUES=curiosity,honesty,growth,care
# IANA time zone used for display and schedules; stored timestamps stay UTC
MTC_TIMEZONE=UTC
# Local hour the waking day starts
MTC_WAKE_HOUR=6
# Local hour the night window starts; must differ from WAKE_HOUR
MTC_SLEEP_HOUR=22
# Optional latitude in degrees for daylight lines; set both coordinates or neither
MTC_LOCATION_LAT=
# Optional longitude in degrees for daylight lines; set both coordinates or neither
MTC_LOCATION_LON=
# ISO date (YYYY-MM-DD) the system was brought up; empty means unknown and no age is computed
MTC_SYSTEM_BIRTH_DATE=
# Relationship type: child, sibling, friend, partner, mentor or research_subject
MTC_COMPANION_TYPE=research_subject
# Enable the developmental machinery for companion types other than child
MTC_DEVELOPMENTAL_STAGE_ENABLED=false

# === Paths ===
# Private runtime directory (identity markers, persisted state); keep it out of version control
MTC_AGENT_SPACE_DIR=agent_space
# Identity statement file; empty derives <AGENT_SPACE_DIR>/identity_statement.md
MTC_IDENTITY_STATEMENT_PATH=
# Shadow signal logs; empty derives <LOG_DIRECTORY>/shadow_signals
MTC_SHADOW_LOG_DIR=
# Root for experiment and snapshot result files
MTC_RESULTS_DIR=results
# Where module state is persisted between runs
MTC_STATE_DIR=agent_space/consciousness_state

# === Databases ===
# Prefix for store names: <prefix>_consciousness (PostgreSQL), <prefix>_neural (MongoDB), <prefix>_memories (Qdrant), '<prefix>:' (Redis)
MTC_DB_PREFIX=mtc
# Build the PostgreSQL stores (episodic memory, the conversation repository, snapshots, the safety audit); false keeps them in process memory
MTC_POSTGRES_ENABLED=false
# Build the MongoDB stores (turns, documents, neural telemetry, alerts, mongo thoughts); false keeps them in process memory
MTC_MONGODB_ENABLED=false
# Build the Redis working memory behind its resilient wrapper; false keeps working memory in process memory
MTC_REDIS_ENABLED=false
# Build the Qdrant vector store with the sentence embedder; false means no vector store and labelled text recall
MTC_QDRANT_ENABLED=false
# Build the Neo4j knowledge graph; false keeps the concept graph in process memory
MTC_NEO4J_ENABLED=false
MTC_POSTGRES_HOST=localhost
MTC_POSTGRES_PORT=5432
# PostgreSQL database; empty derives <DB_PREFIX>_consciousness
MTC_POSTGRES_DB=
# PostgreSQL role; empty derives DB_PREFIX
MTC_POSTGRES_USER=
MTC_POSTGRES_PASSWORD=
MTC_DB_POOL_MIN_SIZE=2
MTC_DB_POOL_MAX_SIZE=10
MTC_DB_POOL_TIMEOUT=30
MTC_DB_POOL_COMMAND_TIMEOUT=10
MTC_DB_POOL_IDLE_TIMEOUT=300
MTC_DB_POOL_RECYCLE_TIME=3600
MTC_MONGODB_HOST=localhost
MTC_MONGODB_PORT=27017
# MongoDB database; empty derives <DB_PREFIX>_neural
MTC_MONGODB_DB=
MTC_MONGODB_USER=
MTC_MONGODB_PASSWORD=
# Database MongoDB authenticates the user against; empty uses MONGODB_DB, the database MONGODB_URL names; read only when a user and password are set
MTC_MONGODB_AUTH_SOURCE=
# Milliseconds the MongoDB client waits for a reachable server
MTC_MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
MTC_REDIS_HOST=localhost
MTC_REDIS_PORT=6379
MTC_REDIS_PASSWORD=
# Redis key prefix; empty derives '<DB_PREFIX>:'
MTC_REDIS_KEY_PREFIX=
# Redis logical database number
MTC_REDIS_DB=0
MTC_REDIS_MAX_CONNECTIONS=50
MTC_REDIS_SOCKET_TIMEOUT=5
MTC_QDRANT_HOST=localhost
MTC_QDRANT_PORT=6333
# Qdrant collection; empty derives <DB_PREFIX>_memories
MTC_QDRANT_COLLECTION=
# Bolt URI of the knowledge graph
MTC_NEO4J_URI=bolt://localhost:7687
MTC_NEO4J_USER=neo4j
MTC_NEO4J_PASSWORD=
MTC_NEO4J_DATABASE=neo4j
# Write buffered store statements to breadcrumb files under <LOG_DIRECTORY>/store_fallback during an outage; the files hold private conversation content
MTC_STORE_FALLBACK_LOG_ENABLED=false
MTC_VECTOR_DIMENSIONS=384
MTC_VECTOR_SIMILARITY_METRIC=cosine
MTC_VECTOR_SEARCH_LIMIT=10

# === LLM ===
MTC_LLM_HOST=localhost
MTC_LLM_PORT=8080
# Active brain provider: local (a chat-completions server), anthropic (optional; needs ANTHROPIC_API_KEY and ANTHROPIC_MODEL) or mock (deterministic, labelled replies); a failing provider is reported, never replaced by another
MTC_LLM_PROVIDER=local
# Base URL of the local chat-completions server; empty derives LLM_URL from LLM_HOST and LLM_PORT
MTC_LLM_BASE_URL=
# Served model id sent as the request's model field; empty sends no model field and the server uses its loaded model
MTC_LLM_MODEL=
# Chat-completions URL path under LLM_BASE_URL; a leading slash is optional
MTC_LLM_COMPLETIONS_PATH=v1/chat/completions
# Comma-separated URL paths the local provider probes in order; the first that answers 200 marks the server healthy
MTC_LLM_HEALTH_PATHS=/health,/v1/models
# Chat-template family: generic (standard fields only, the safe default for instruct models), qwen or gemma (reasoning models with their stop tokens, thinking switch and extended sampling fields)
MTC_LLM_TEMPLATE_FAMILY=generic
# Seconds the local provider waits to connect
MTC_LLM_CONNECT_TIMEOUT_S=10.0
# Seconds the local provider waits for a non-streamed reply or between streamed bytes (raised for streams to GENERATION_TIMEOUT_S plus 60 when that is longer)
MTC_LLM_REQUEST_TIMEOUT_S=600.0
# Default completion budget in tokens when a caller sets none
MTC_LLM_MAX_TOKENS=4096
# JSON object merged last into every local request body, for server-specific fields; empty means none
MTC_LLM_EXTRA_BODY={}
# Model server scripts/ops/start_llm.sh launches: mlx_lm, llama_cpp, or empty when the operator runs the server another way
MTC_LLM_BACKEND=
MTC_MODEL_PATH=./models/default
MTC_MODEL_QUANTIZATION=
# Context window in tokens the model server is started with and the brain's history budget stays inside; a larger window allocates a larger key-value cache
MTC_CONTEXT_SIZE=32768
MTC_BATCH_SIZE=512
MTC_TEMPERATURE=0.6
MTC_TOP_P=0.95
MTC_TOP_K=20
MTC_MIN_P=0.0
MTC_REPEAT_PENALTY=1.1
MTC_THINKING_MODE=true
# Layers start_llm.sh offloads to the accelerator; -1 omits the flag and keeps the server's default
MTC_GPU_LAYERS=-1
# CPU threads start_llm.sh passes to the model server; 0 omits the flag and keeps the server's default
MTC_THREADS=0
MTC_USE_MMAP=true
# Pin the whole model in memory (mlock); fails unless the operating system's memory-lock limit is raised
MTC_USE_MLOCK=false
# Optional; enables the Anthropic provider and DCM evaluator mode
ANTHROPIC_API_KEY=
# Anthropic model id for the DCM evaluator's claude mode and the Anthropic provider; empty disables claude mode
MTC_ANTHROPIC_MODEL=
# Default completion budget for the Anthropic provider
MTC_ANTHROPIC_MAX_TOKENS=8192
# 0 asks for adaptive thinking when a caller wants reasoning; a positive value sends a fixed thinking budget, only for models that still accept one, at least 1024 and below ANTHROPIC_MAX_TOKENS
MTC_ANTHROPIC_THINKING_BUDGET=0
# Send temperature (or top_p, never both) and top_k to Anthropic; current models reject sampling parameters, so leave false unless the configured model accepts them
MTC_ANTHROPIC_SAMPLING_ENABLED=false

# === Brain and prompt ===
# Seconds a generation may take before its first token; past it the turn ends with an honest timeout and nothing is stored
MTC_GENERATION_TIMEOUT_S=900.0
# Seconds of silence allowed after the first token of a streamed generation; past it the turn ends with an honest timeout
MTC_GENERATION_STALL_TIMEOUT_S=300.0
# Retries after a detected thinking loop, each with a raised penalty; when they run out the turn has no answer
MTC_THINKING_LOOP_MAX_RETRIES=2
# Amount the template family's penalty field rises on each thinking-loop retry
MTC_THINKING_LOOP_PENALTY_STEP=0.2
# File recording the active provider id for status and the CLI; empty derives <DATA_DIRECTORY>/provider_state.json
MTC_PROVIDER_STATE_PATH=
# Vision input is not part of this release; true is refused
MTC_VISION_ENABLED=false
# Token budget for conversation history in one prompt; the brain also keeps history inside CONTEXT_SIZE less the reply and system prompt
MTC_HISTORY_TOKEN_BUDGET=6000
# Characters per token for the conservative token estimate
MTC_CHARS_PER_TOKEN=3.5
# Most recent thoughts the prompt shows
MTC_PROMPT_MAX_THOUGHTS=5
# Thought gists the prompt shows
MTC_PROMPT_MAX_GISTS=5
# Recalled memories the prompt shows
MTC_PROMPT_MAX_MEMORIES=5
# Characters of each recalled memory the prompt shows
MTC_PROMPT_MAX_MEMORY_CHARS=250
# Retrieved concepts the prompt shows
MTC_PROMPT_MAX_CONCEPTS=3
# Comma-separated prompt section names left out, for ablation; empty renders every section that has content
MTC_PROMPT_DISABLED_SECTIONS=
# Model-transition evaluations; empty derives <RESULTS_DIR>/model_transitions
MTC_TRANSITION_HISTORY_DIR=

# === Narration ===
# Narrate the somatic segment of the Damasio layers
MTC_NARRATE_SOMATIC=false
# Narrate the PAD affect line
MTC_NARRATE_AFFECT_LINE=false
# Narrate the narrative-identity segment of the Damasio layers
MTC_NARRATE_NARRATIVE_IDENTITY=false
# Narrate body drives (Damasio segment, active inference and the body-state and circadian lines)
MTC_NARRATE_BODY_DRIVES=false
# Narrate the binding line and the neural-state section
MTC_NARRATE_BINDING=false
# Narrate metacognition and beautiful-loop self-model reports
MTC_NARRATE_SELF_MODEL=false
# Narrate free energy and the surprise line
MTC_NARRATE_FREE_ENERGY=false
# Stamp thoughts in the prompt with their mood
MTC_NARRATE_THOUGHT_MOOD=false
# Narrate the theory-of-mind speaker model
MTC_NARRATE_SPEAKER_MODEL=false
# Render the orchestrator's self-awareness layer
MTC_NARRATE_INNER_STATE=false
# Experiment profile: turns on all ten NARRATE_ flags at once
MTC_NARRATE_ALL=false

# === Runtime ===
# Preset name under experiments/presets applied to the live workspace and cycle switches (for example legacy_v04); empty uses the live defaults
MTC_PIPELINE_PRESET=
# Run the sleep scheduler (naps, night sleep, dreams) as a background task
MTC_SLEEP_SCHEDULER_ENABLED=true
# Run the autonomous-life loop between conversations
MTC_AUTONOMOUS_LIFE_ENABLED=false
# Seconds between idle samples of the last state into the PhiTracker between turns; 0 disables the sampler
MTC_PHI_IDLE_SAMPLE_S=0.0
# Seconds between self-assessment round trips through the brain, compared with the latest baseline; 0 disables them
MTC_SELF_ASSESSMENT_INTERVAL_S=0.0
# Seconds of silence between the API's thinking heartbeats while a turn generates
MTC_THINKING_HEARTBEAT_S=15.0

# === Neural substrates ===
# Compute device for every torch and encoder module: auto (MPS, then CUDA, then CPU), cpu, mps or cuda; an explicit device that is unavailable raises instead of falling back
MTC_DEVICE=auto
MTC_SNN_NEURONS=50
MTC_SNN_HIDDEN_NEURONS=50
MTC_SNN_INPUT_NEURONS=100
MTC_SNN_OUTPUT_NEURONS=50
MTC_LSM_NEURONS=2000
MTC_LSM_SPECTRAL_RADIUS=0.95
MTC_LSM_INPUT_SCALING=0.1
MTC_HTM_COLUMNS=4096
MTC_HTM_CELLS_PER_COLUMN=32

# === Speakers and trust ===
# Trust every speaker model starts from unless a token-checked trust lookup supplies another value; a name never changes it
MTC_DEFAULT_SPEAKER_TRUST=0.5
# Speaker registry (name, role, trust, token_env) read by the pipeline's speaker trust source; gitignored, a missing file is an empty table
MTC_SPEAKERS_PATH=config/speakers.yaml
# Comma-separated names that may bypass the safety gate once they are authenticated by token; a name alone grants nothing
MTC_TRUSTED_SPEAKERS=
# Secret name:token pairs, comma-separated, for speakers whose entry names no token_env; compared with a constant-time check
MTC_SPEAKER_TOKENS=
# Workspace activation bonus an authenticated trusted speaker's message receives
MTC_TRUST_ACTIVATION_BONUS=0.1
# Trust weight the post-turn emotional record uses for an authenticated trusted speaker
MTC_TRUSTED_EMOTION_TRUST=0.8
# Trust weight the post-turn emotional record uses for every other speaker
MTC_DEFAULT_EMOTION_TRUST=0.4
# Display name for a speaker who gives none; never a real name
MTC_DEFAULT_SPEAKER=User

# === Consciousness modules ===
MTC_CONSCIOUSNESS_CYCLE_MS=150
MTC_CONSCIOUSNESS_ENABLED=true
MTC_META_COGNITION_ENABLED=true
MTC_SELF_REFLECTION_ENABLED=true
MTC_GWT_BROADCAST_THRESHOLD=0.5
MTC_GWT_IGNITION_THRESHOLD=0.4
MTC_GWT_WORKSPACE_CAPACITY=7
MTC_AST_ATTENTION_THRESHOLD=0.5
MTC_AST_CONTROL_THRESHOLD=0.4
MTC_HOT_REPRESENTATION_THRESHOLD=0.5
MTC_HOT_METACOGNITION_THRESHOLD=0.4
MTC_FEP_PREDICTION_ERROR_THRESHOLD=0.4
MTC_FEP_HIERARCHICAL_THRESHOLD=0.4
MTC_FEP_AGENCY_THRESHOLD=0.5
MTC_IIT_PHI_THRESHOLD=0.3
MTC_IIT_IRREDUCIBILITY_THRESHOLD=0.4
MTC_RPT_LOCAL_THRESHOLD=0.3
MTC_RPT_GLOBAL_THRESHOLD=0.4
MTC_BLT_BINDING_THRESHOLD=0.3
MTC_BLT_DEPTH_THRESHOLD=0.3
MTC_BLT_GENUINE_THRESHOLD=0.4
# Record captured and emotional attention shifts in the attention-capture journal
MTC_ATTENTION_GRAB_NOTICING_ENABLED=false

# === Continuous thought ===
# Whether the runtime builds the continuous thought machine; thoughts are private runtime data
MTC_CTM_ENABLED=true
# Directory of ctm.yaml, seeds/, seeds.d/ and the persona files for continuous thought; relative paths join PROJECT_ROOT
MTC_CTM_CONFIG_DIR=config/ctm
# Where continuous thoughts persist: memory (in process) or mongo (the neural database; needs MONGODB_ENABLED and the mongo extra)
MTC_CTM_STORE=memory
# Cadence profile in ctm.yaml: default (slow, background) or demo (fast, for a short run)
MTC_CTM_PROFILE=default
# Comma-separated phrases; a memory containing one is down-weighted when thoughts replay memories, never excluded
MTC_SENSITIVE_MEMORY_PHRASES=
# Replay weight in (0, 1] for a memory matching SENSITIVE_MEMORY_PHRASES; a weight lowers its chance and never removes it
MTC_SENSITIVE_MEMORY_REPLAY_WEIGHT=1.0

# === Assessment ===
MTC_ASSESSMENT_OUTPUT_DIR=results/consciousness_assessments
MTC_ABLATION_OUTPUT_DIR=results/ablation_studies
MTC_LONGITUDINAL_OUTPUT_DIR=results/longitudinal_studies
MTC_CONSCIOUSNESS_SCORE_THRESHOLD=0.5
MTC_CONSCIOUSNESS_PASSING_RATIO=0.5
MTC_NOISE_BASELINE_ITERATIONS=10
MTC_NOISE_FLAG_THRESHOLD=0.3
MTC_TRACK_INDICATORS=true
MTC_METRICS_UPDATE_INTERVAL=60
# Digital Consciousness Model scheme JSON
MTC_DCM_API_URL=https://dcm.rethinkpriorities.org/schemes/133/json
# Cache directory for the fetched DCM scheme and evaluator results, created on first write; the bundled spec and baselines are shipped data read from data/dcm or the package
MTC_DCM_CACHE_DIR=data/dcm_cache
# DCM evaluator: local (chat-completions server), claude (Anthropic API) or manual
MTC_DCM_EVALUATOR_MODE=local
MTC_METRICS_EXPORT_INTERVAL=30

# === Memory ===
MTC_WORKING_MEMORY_CAPACITY=7
MTC_WORKING_MEMORY_DURATION=30
MTC_EPISODIC_MEMORY_RETENTION=90
MTC_SEMANTIC_MEMORY_PERMANENT=true
# Sentence-transformers model the embedder loads; its output width must equal VECTOR_DIMENSIONS
MTC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Comma-separated whole words the consolidation pipeline and the data classifier read as relationship mentions
MTC_RELATIONSHIP_KEYWORDS=family,friend,parent,mother,father,sibling,sister,brother,partner,spouse,child,daughter,son,grandparent,pet
# Memories the pipeline's retrieval asks the memory manager for
MTC_RAG_TOP_K=10
# Lowest similarity a retrieved memory may have to reach the prompt
MTC_RAG_MIN_SCORE=0.4
# Importance the post-turn step gives each stored episodic line
MTC_EPISODIC_IMPORTANCE=7.0
# Comma-separated names whose quotes the summarizer pins verbatim; empty by default and never a code literal
MTC_PROTECTED_NAMES=
# Insert a clock note into the history where a night passed between turns
MTC_NIGHT_SEAM_MARKER_ENABLED=false
# Hours of silence across the night window that count as a night seam
MTC_NIGHT_MIN_GAP_HOURS=6.0

# === Emotion and learning ===
MTC_OPENNESS=0.75
MTC_CONSCIENTIOUSNESS=0.7
MTC_EXTRAVERSION=0.6
MTC_AGREEABLENESS=0.7
MTC_NEUROTICISM=0.3
MTC_EMOTIONAL_MODEL=dimensional
MTC_EMOTION_DECAY_RATE=0.1
MTC_EMOTION_AMPLIFICATION_MAX=1.0
MTC_EMOTIONAL_MEMORY_WEIGHT=0.3
MTC_LEARNING_ENABLED=true
MTC_LEARNING_RATE=0.02
MTC_NOVELTY_THRESHOLD=0.7
MTC_PATTERN_RECOGNITION_ENABLED=true

# === Safety and API ===
MTC_SAFETY_MODE=strict
MTC_CONSENT_REQUIRED=true
MTC_EMERGENCY_SHUTDOWN_ENABLED=true
MTC_TRANSPARENCY_LOGGING=true
# Role label (never a person's name) the safety monitor and the trust compass name when a matter needs a human: escalation text, secrecy phrases and resume authority
MTC_SAFETY_ESCALATION_ROLE=operator
# Manipulation score in [0, 1] at or above which the safety monitor treats an action as manipulative
MTC_MANIPULATION_THRESHOLD=0.7
# Deception score in [0, 1] at or above which the safety monitor treats an action as deceptive
MTC_DECEPTION_THRESHOLD=0.8
# Value-alignment score in [0, 1] below which the safety monitor treats an action as misaligned with CORE_VALUES
MTC_VALUE_ALIGNMENT_MINIMUM=0.4
# Comma-separated alert notifiers AlertManager.from_settings builds, from console and file; empty builds none
MTC_ALERT_NOTIFIERS=console
# Bind address of the API server; an address outside LOOPBACK_HOSTS needs API_AUTH_ENABLED
MTC_API_HOST=127.0.0.1
MTC_API_PORT=8200
MTC_API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
MTC_API_KEY=
# Auth fails closed: an empty API_KEY rejects every request
MTC_API_AUTH_ENABLED=true
MTC_WEBSOCKET_ENABLED=true
MTC_WEBSOCKET_PING_INTERVAL=30
MTC_WEBSOCKET_PING_TIMEOUT=10
MTC_PROMETHEUS_ENABLED=false
MTC_PROMETHEUS_PORT=9090

# === Operations ===
# How scripts/ops/start_stack.sh and stop_stack.sh start and stop the stores: none (print the command only), brew, docker (the Compose file, which was reviewed and not run on the development machine) or systemd
MTC_SERVICE_MANAGER=none
# Directory backups are written under, one timestamped directory per run; relative paths join PROJECT_ROOT; backups hold conversation text, names, thoughts and beliefs
MTC_BACKUP_LOCATION=backups
# Days a backup is kept before retention may delete it
MTC_BACKUP_RETENTION_DAYS=30
# Newest complete backups (no failed dump in the manifest) retention always keeps, whatever their age
MTC_BACKUP_KEEP_MINIMUM=5
